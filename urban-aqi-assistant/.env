# Copy this file to ".env" (same folder), paste your keys after the = signs,
# and restart the app. The keys then load automatically on every start.
# Keep .env private - never commit or share it.

# Free token: https://aqicn.org/data-platform/token/
# Unlocks full pollutant breakdown (PM2.5, PM10, NO2, SO2, CO, O3) for every city.
WAQI_TOKEN=

# Free key: https://explore.openaq.org/register
# Station-level PM2.5/PM10 concentrations from official monitors.
OPENAQ_API_KEY=
